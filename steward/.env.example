# Frontend environment (Next.js). Copy to .env.local and fill in.
# NEXT_PUBLIC_* values are exposed to the browser; the rest are server-only.

# Clerk auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...

# Clerk redirect URLs (optional — Clerk has sensible defaults)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Cron proxy → FastAPI backend.
# BACKEND_URL is where the /api/cron/* proxy forwards to. In local dev the
# default localhost is correct. In production (single Vercel project) set it to
# your deployed origin so the cron proxy reaches the Python function, e.g.:
#   BACKEND_URL=https://your-app.vercel.app
BACKEND_URL=http://127.0.0.1:8000

# Shared secret guarding the cron endpoints (must match the API's CRON_SECRET)
CRON_SECRET=<random-secret-at-least-32-chars>

# Origin that serves static email assets (the header logo). Usually the same
# as your deployed origin; overridable for preview deployments.
EMAIL_ASSET_BASE_URL=https://stward.app

# Vercel Blob — read/write token for the asset image store (client-upload
# token endpoint + blob delete + backfill script). Create with the Blob store
# in the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
