# Clerk
CLERK_JWKS_URL=https://<clerk-domain>/.well-known/jwks.json
CLERK_SECRET_KEY=sk_...

# Database
# DATABASE_URL: pooled connection used by the app at request time.
# DATABASE_URL_UNPOOLED: direct (non-PgBouncer) connection used ONLY for
#   Alembic migrations — run `alembic upgrade head` before each deploy.
DATABASE_URL=postgresql+psycopg://user:pass@host/db?sslmode=require
DATABASE_URL_UNPOOLED=postgres://user:pass@host/db?sslmode=require

# CORS: comma-separated list of allowed origins. Falls back to localhost:3000.
# In production set this to your deployed frontend origin, e.g.:
#   ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Redis (optional — fails gracefully if not set)
REDIS_URL=redis://localhost:6379

# Clerk billing plan IDs (from Clerk dashboard)
CLERK_PLAN_STARTER_ID=cplan_...
CLERK_PLAN_PRO_ID=cplan_...

# Email notifications (Pro plan feature)
RESEND_API_KEY=re_...
FROM_EMAIL=Steward <notifications@stward.app>

# Origin that serves static email assets (the header logo). Point preview/dev
# deployments at their own origin so the logo resolves before the prod domain.
EMAIL_ASSET_BASE_URL=https://stward.app

# Cron job secret — shared between the Next.js cron proxy and this API
CRON_SECRET=<random-secret-at-least-32-chars>

# AI assistant (planned/future feature — not required to run the app)
# ANTHROPIC_API_KEY=sk-ant-...
